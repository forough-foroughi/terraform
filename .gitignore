# Terraform working directory and local state
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Variable files may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local credentials and private keys
.env
.env.*
!.env.example
*.pem
*.key

# Local Terraform lock files
*.tfstate.lock.info